{
  "name": "ash-qr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ash QR — a lightweight QR code generator for construction / BIM project documentation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
